; NPT Equilibration Archetype Template
define                   = {DEFINE}
integrator               = md
dt                       = 0.002
nsteps                   = {NSTEPS}

nstxout-compressed       = 5000
nstenergy                = 1000
nstlog                   = 1000

cutoff-scheme            = Verlet
nstlist                  = 40
rlist                    = 1.0
verlet-buffer-tolerance  = 0.005
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
vdw-modifier             = None
DispCorr                 = {DISPCORR}
rvdw                     = 1.0
pbc                      = xyz

tcoupl                   = V-rescale
tc-grps                  = {TC_GRPS}
tau-t                    = 0.1 0.1
ref-t                    = {TEMP} {TEMP}

pcoupl                   = {PCOUPL}
pcoupltype               = {PCOUPL_TYPE}
tau-p                    = {TAU_P}
ref-p                    = {REF_P}
compressibility          = {COMPRESSIBILITY}
refcoord-scaling         = com

constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

continuation             = yes
gen_vel                  = no

nstcomm                  = 100
comm-mode                = Linear
comm-grps                = System