; Energy Minimization Archetype Template
define                   = {DEFINE}
integrator               = steep
emtol                    = 500.0
emstep                   = 0.01
nsteps                   = 50000

nstxout                  = 0
nstvout                  = 0
nstenergy                = 1000
nstlog                   = 1000

cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.0
verlet-buffer-tolerance  = 0.005
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = cutoff
rvdw                     = 1.0
pbc                      = xyz

constraints              = none
