; Energy Minimization Archetype Template
define                   = {DEFINE}
integrator               = steep
emtol                    = 500.0
emstep                   = 0.01
nsteps                   = 50000

nstxout                  = 0
nstvout                  = 0
nstenergy                = 1000
nstlog                   = 1000

cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = cutoff
rvdw                     = 1.0
pbc                      = xyz

constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1
