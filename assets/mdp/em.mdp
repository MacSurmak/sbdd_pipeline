; Energy Minimization Archetype Template
define                   = {DEFINE}
integrator               = steep
emtol                    = 500.0
emstep                   = 0.01
nsteps                   = 50000

nstxout                  = 0
nstvout                  = 0
nstenergy                = 1000
nstlog                   = 1000

cutoff-scheme            = Verlet
nstlist                  = 1
rlist                    = 1.0
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
vdw-modifier             = None
DispCorr                 = EnerPres
rvdw                     = 1.0
pbc                      = xyz

constraints              = none
