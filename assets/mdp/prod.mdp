; Production MD Archetype Template
{DEFINE}
integrator               = md
dt                       = {DT}
nsteps                   = {NSTEPS}

nstxout-compressed       = {NSTXOUT}
nstcalcenergy            = {NSTENERGY}
nstenergy                = {NSTENERGY}
nstlog                   = {NSTENERGY}

cutoff-scheme            = Verlet
nstlist                  = 80
verlet-buffer-tolerance  = 0.005
rlist                    = 1.0
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift-Verlet
DispCorr                 = {DISPCORR}
rvdw                     = 1.0
pbc                      = xyz

tcoupl                   = v-rescale
tc-grps                  = {TC_GRPS}
tau-t                    = 0.1 0.1
ref-t                    = {TEMP} {TEMP}

pcoupl                   = Parrinello-Rahman
pcoupltype               = {PCOUPL_TYPE}
tau-p                    = {TAU_P}
ref-p                    = {REF_P}
compressibility          = {COMPRESSIBILITY}
refcoord-scaling         = com

constraints              = h-bonds
constraint-algorithm     = LINCS
continuation             = yes
lincs-order              = {LINCS_ORDER}
lincs-iter               = {LINCS_ITER}

nstcomm                  = 100
comm-mode                = Linear
comm-grps                = System
gen_vel                  = no
