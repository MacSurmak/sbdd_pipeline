; Production MD Archetype Template
{DEFINE}
integrator               = md
dt                       = 0.002
nsteps                   = {NSTEPS}

nstxout-compressed       = {NSTXOUT}
nstcalcenergy            = {NSTENERGY}
nstenergy                = {NSTENERGY}
nstlog                   = {NSTENERGY}

cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
rlist                    = 1.0
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
vdw-modifier             = None
DispCorr                 = EnerPres
rvdw                     = 1.0
pbc                      = xyz

tcoupl                   = v-rescale
tc-grps                  = {TC_GRPS}
tau-t                    = 0.1 0.1
ref-t                    = {TEMP} {TEMP}

pcoupl                   = Parrinello-Rahman
pcoupltype               = {PCOUPL_TYPE}
tau-p                    = 5.0
ref-p                    = {REF_P}
compressibility          = {COMPRESSIBILITY}

constraints              = h-bonds
constraint-algorithm     = LINCS
continuation             = yes
lincs-order              = 4
lincs-iter               = 1

nstcomm                  = 100
comm-mode                = Linear
comm-grps                = System
gen_vel                  = no
