; NVT Thermalization Archetype Template
define                   = {DEFINE}
integrator               = md
dt                       = 0.001
nsteps                   = 100000 ; 100 ps

nstxout-compressed       = 5000
nstenergy                = 1000
nstlog                   = 1000

cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.0
verlet-buffer-tolerance  = 0.005
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
vdw-modifier             = None
DispCorr                 = EnerPres
rvdw                     = 1.0
pbc                      = xyz

tcoupl                   = V-rescale
tc-grps                  = {TC_GRPS}
tau-t                    = 0.1 0.1
ref-t                    = {TEMP} {TEMP}

pcoupl                   = no

constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

continuation             = no
gen_vel                  = yes
gen_temp                 = {TEMP}
gen_seed                 = -1

nstcomm                  = 100
comm-mode                = Linear
comm-grps                = System