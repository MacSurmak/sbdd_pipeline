/*
 * conf/base.config
 * Dynamic resource distribution without hardcoded constraints
 */

process {
    cache         = 'lenient'
    // Retry on memory limits, segfaults, or kernel OOM killer (exitStatus null/-) dynamically requesting more memory
    errorStrategy = { (task.exitStatus in [143, 137, 104, 134, 139] || task.exitStatus == null) ? 'retry' : 'terminate' }
    maxRetries    = 3

    // Default fallback resources
    cpus   = 1
    memory = { def m = 2.GB * task.attempt; m > params.max_memory ? params.max_memory : m }
    time   = 1.h

    // Master node local execution (for preprocessing, staging, and packaging)
    withLabel: process_master {
        executor = 'local'
        scratch  = false
        cpus     = 2
    }

    // Single-threaded tasks (Packmol, Antechamber, python scripts)
    withLabel: process_single {
        cpus   = 1
        memory = { def m = 4.GB * task.attempt; m > params.max_memory ? params.max_memory : m }
        time   = 1.h
    }

    // Lightweight parallel tasks (TRJCONV, minor utilities)
    withLabel: process_low {
        cpus   = { Math.min( 2 * task.attempt, params.max_cpus as int ) }
        memory = { def m = 4.GB * task.attempt; m > params.max_memory ? params.max_memory : m }
        time   = 2.h
    }

    // Medium parallel tasks (LigPrep, PrepWizard, short CPU jobs)
    withLabel: process_medium {
        cpus   = { Math.min( 4 * task.attempt, params.max_cpus as int ) }
        memory = { def m = 8.GB * task.attempt; m > params.max_memory ? params.max_memory : m }
        time   = 12.h
    }

    // Heavy CPU multi-threaded tasks (MM-PBSA, Prime)
    withLabel: process_high {
        cpus   = { Math.min( 8 * task.attempt, params.max_cpus as int ) }
        memory = { def m = 12.GB * task.attempt; m > params.max_memory ? params.max_memory : m }
        time   = 24.h
    }

    // GPU-accelerated tasks (GROMACS, GNINA)
    withLabel: process_gpu {
        cpus   = { Math.min( 8 * task.attempt, params.max_cpus as int ) }
        memory = { def m = 8.GB * task.attempt; m > params.max_memory ? params.max_memory : m }
        time   = 48.h
    }

    withLabel: process_urgent {
        queue = 'urgent'
        time  = 2.h
    }
}

