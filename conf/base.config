/*
 * conf/base.config
 * Dynamic resource distribution without hardcoded constraints
 */

process {
    // Retry on memory limits or segfaults dynamically requesting more memory up to max
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'terminate' }
    maxRetries    = 3

    // Default fallback resources
    cpus   = 1
    memory = { check_max( 2.GB * task.attempt, 'memory' ) }
    time   = 1.h

    // Master node local execution (for preprocessing, staging, and packaging)
    withLabel: process_master {
        executor = 'local'
        scratch  = false
        cpus     = 2
    }

    // Single-threaded tasks (Packmol, Antechamber, python scripts)
    withLabel: process_single {
        cpus   = 1
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = 1.h
    }

    // Lightweight parallel tasks (TRJCONV, minor utilities)
    withLabel: process_low {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = 2.h
    }

    // Medium parallel tasks (LigPrep, PrepWizard, short CPU jobs)
    withLabel: process_medium {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = 12.h
    }

    // Heavy CPU multi-threaded tasks (MM-PBSA, Prime)
    withLabel: process_high {
        cpus   = { check_max( 8 * task.attempt, 'cpus' ) }
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        time   = 24.h
    }

    // GPU-accelerated tasks (GROMACS, GNINA)
    withLabel: process_gpu {
        cpus     = { check_max( 4 * task.attempt, 'cpus' ) }
        memory   = { check_max( 8.GB * task.attempt, 'memory' ) }
        time     = 48.h
    }

    withLabel: process_urgent {
        queue = 'urgent'
        time  = 2.h
    }
}

