/*
 * conf/slurm.config
 * Slurm HPC cluster configuration
 */

profiles {
    slurm {
        executor {
            name         = 'slurm'
            queueSize    = 50
            pollInterval = '1 sec'
            jobName      = {
                def proc = task.process.tokenize(':').last()
                def shortMap = [
                    'HEAL_STRUCTURE': 'HEAL',
                    'EXTRACT_COMPLEX': 'EXTR',
                    'IMMERS': 'PPM',
                    'ORIENT_COMPLEX': 'ORN',
                    'PREPWIZARD': 'PW',
                    'APPLY_MEMBRANE': 'MEM',
                    'SPLIT_PREPARED': 'SPLT',
                    'LIGPREP': 'LP',
                    'ASSEMBLE_DOCKING_RECEPTOR': 'ASM',
                    'GLIDE_GRIDGEN': 'GRID',
                    'GLIDE_DOCK': 'GLD',
                    'GNINA_DOCK': 'GNA',
                    'GNINA_RESCORE': 'GNAR',
                    'PRIME_MMGBSA': 'MMGB',
                    'FILTER_PV': 'FPV',
                    'VALIDATE_LIGAND': 'VAL',
                    'ORCA_PREOPT': 'OPRE',
                    'ORCA_REFINE_OPT': 'OREF',
                    'ORCA_ESP_CALC': 'OESP',
                    'FIT_RESP_CHARGES': 'RESP',
                    'BUILD_TOPOLOGY_GAFF2': 'GAFF',
                    'PARAMETRIZE_SUBSTANCE_BCC': 'BCC',
                    'PARAMETRIZE_SUBSTANCE_OPENFF': 'OFF',
                    'MERGE_PDB': 'MPDB',
                    'PACKMOL_MEMGEN': 'PCKM',
                    'TLEAP': 'TLP',
                    'TLEAP_DRY': 'TLPD',
                    'PARMED': 'PRMD',
                    'DECLASH': 'DCL',
                    'NDX_POSRE': 'NDX',
                    'PUBLISH_MD_SYSTEM': 'PUB',
                    'GMX_EQUILIBRATION': 'EQ',
                    'TRJCONV': 'TRJC',
                    'MD_METRICS': 'MTR',
                    'GMX_MMPBSA': 'MMPB',
                    'TRAJ_DIM_REDUCTION': 'TICA',
                    'CLUSTER_BASINS': 'CLST',
                    'RENDER_REPORTS': 'RPT',
                    'EXTRACT_MEDOID_COMPLEXES': 'MED'
                ]
                def pCode = proc.startsWith('RUN_MD_CHUNK') ? 'MD' : (shortMap[proc] ?: proc.take(6))
                def tTag = task.tag ? "_${task.tag}" : ""
                "${pCode}${tTag}".replaceAll(/[^a-zA-Z0-9_.-]/, '_').take(24)
            }
        }

        env {
            LC_ALL = 'C.UTF-8'
            LANG   = 'C.UTF-8'
            PATH   = '/opt/containers/bin:/usr/local/bin:$PATH'
        }

        process {
            cache          = 'lenient'
            executor       = 'slurm'
            queue          = 'main'
            clusterOptions = '--requeue'
            stageInMode    = 'copy'
            scratch        = '$SLURM_TMPDIR'
            beforeScript   = 'source /opt/miniforge3/etc/profile.d/conda.sh && conda activate /opt/miniforge3/envs/sbdd_cluster_env'

            withLabel: process_master {
                executor = 'local'
                scratch  = false
            }
            withLabel: process_gpu {
                queue          = 'main'
                clusterOptions = '--gres=gpu:1 --requeue'
                scratch        = '$SLURM_TMPDIR'
            }

            withLabel: process_gpu_shard {
                queue          = 'main'
                clusterOptions = { "--gres=${params.gnina_gres} --requeue" }
                scratch        = '$SLURM_TMPDIR'
            }

            withLabel: process_urgent {
                queue = 'urgent'
            }
        }
    }

    local {
        env {
            LC_ALL = 'C.UTF-8'
            LANG = 'C.UTF-8'
            PATH = '/opt/containers/bin:/usr/local/bin:$PATH'
        }

        process {
            executor     = 'local'
            beforeScript = 'source /opt/miniforge3/etc/profile.d/conda.sh && conda activate /opt/miniforge3/envs/sbdd_cluster_env'
            
            withLabel: process_gpu {
                maxForks = 1
            }
        }
    }
}
