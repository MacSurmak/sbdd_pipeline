/*
 * conf/slurm.config
 * Slurm HPC cluster configuration
 */

profiles {
    slurm {
        executor {
            name         = 'slurm'
            queueSize    = 50
            pollInterval = '1 sec'
        }

        env {
            LC_ALL = 'C.UTF-8'
            LANG = 'C.UTF-8'
            SCHRODINGER_JOBDB_DIR = './.jobdb'
            SCHRODINGER_TMPDIR = './.schrodinger_tmp'
        }

        process {
            executor       = 'slurm'
            queue          = 'main'
            clusterOptions = '--requeue'
            stageInMode    = 'copy'
            scratch        = '$SLURM_TMPDIR'
            conda          = 'sbdd_cluster_env'

            withLabel: process_master {
                executor = 'local'
                scratch  = false
            }

            withLabel: process_gpu {
                queue          = 'main'
                clusterOptions = '--gres=gpu:1 --requeue'
                scratch        = '$SLURM_TMPDIR'
            }

            withLabel: process_urgent {
                queue = 'urgent'
            }
        }
    }

    local {
        env {
            LC_ALL = 'C.UTF-8'
            LANG = 'C.UTF-8'
            SCHRODINGER_JOBDB_DIR = './.jobdb'
            SCHRODINGER_TMPDIR = './.schrodinger_tmp'
        }

        process {
            executor = 'local'
            conda    = 'sbdd_cluster_env'
            
            withLabel: process_gpu {
                maxForks = 1
            }
        }
    }
}
