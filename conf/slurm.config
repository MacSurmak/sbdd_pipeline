/*
 * conf/slurm.config
 * Slurm HPC cluster configuration
 */

profiles {
    slurm {
        executor {
            name         = 'slurm'
            queueSize    = 50
            pollInterval = '1 sec'
            jobName      = {
                def proc = task.process.tokenize(':').last()
                def tTag = task.tag ? "_${task.tag}" : ""
                "${proc}${tTag}".replaceAll(/[^a-zA-Z0-9_.-]/, '_').take(30)
            }
        }

        env {
            LC_ALL = 'C.UTF-8'
            LANG   = 'C.UTF-8'
            PATH   = '/opt/containers/bin:/usr/local/bin:$PATH'
            APPTAINER_BINDPATH   = '/etc/machine-id'
            SINGULARITY_BINDPATH = '/etc/machine-id'
        }

        process {
            executor       = 'slurm'
            queue          = 'main'
            clusterOptions = '--requeue'
            stageInMode    = 'copy'
            scratch        = '$SLURM_TMPDIR'
            beforeScript   = 'source /opt/miniforge3/etc/profile.d/conda.sh && conda activate /opt/miniforge3/envs/sbdd_cluster_env && export APPTAINER_BINDPATH="/etc/machine-id$(T=$(ls /lib/x86_64-linux-gnu/libtirpc.so.3 /usr/lib/x86_64-linux-gnu/libtirpc.so.3 /usr/lib/libtirpc.so.3 2>/dev/null | head -n 1); [ -n "$T" ] && echo ",$T:/usr/lib/x86_64-linux-gnu/libtirpc.so.3,$T:/lib/x86_64-linux-gnu/libtirpc.so.3")${APPTAINER_BINDPATH:+,$APPTAINER_BINDPATH}" && export SINGULARITY_BINDPATH="$APPTAINER_BINDPATH"'

            withLabel: process_master {
                executor = 'local'
                scratch  = false
            }
            withLabel: process_gpu {
                queue          = 'main'
                clusterOptions = '--gres=gpu:1 --requeue'
                scratch        = '$SLURM_TMPDIR'
            }

            withLabel: process_urgent {
                queue = 'urgent'
            }
        }
    }

    local {
        env {
            LC_ALL = 'C.UTF-8'
            LANG = 'C.UTF-8'
            PATH = '/opt/containers/bin:/usr/local/bin:$PATH'
        }

        process {
            executor     = 'local'
            beforeScript = 'source /opt/miniforge3/etc/profile.d/conda.sh && conda activate /opt/miniforge3/envs/sbdd_cluster_env'
            
            withLabel: process_gpu {
                maxForks = 1
            }
        }
    }
}
