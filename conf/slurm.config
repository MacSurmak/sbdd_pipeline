/*
 * conf/slurm.config
 * Slurm HPC cluster configuration
 */

profiles {
    slurm {
        executor {
            name         = 'slurm'
            queueSize    = 50
            pollInterval = '1 sec'
            jobName      = {
                def proc = task.process.tokenize(':').last()
                def tTag = task.tag ? "_${task.tag}" : ""
                "${proc}${tTag}".replaceAll(/[^a-zA-Z0-9_.-]/, '_').take(30)
            }
        }

        env {
            LC_ALL = 'C.UTF-8'
            LANG = 'C.UTF-8'
        }

        process {
            executor       = 'slurm'
            queue          = 'main'
            clusterOptions = '--requeue'
            stageInMode    = 'copy'
            scratch        = '$SLURM_TMPDIR'
            beforeScript   = 'export PATH="/opt/conda/envs/sbdd_cluster_env/bin:$PATH"'

            withLabel: process_master {
                executor = 'local'
                scratch  = false
            }

            withLabel: process_gpu {
                queue          = 'main'
                clusterOptions = '--gres=gpu:1 --requeue'
                scratch        = '$SLURM_TMPDIR'
            }

            withLabel: process_urgent {
                queue = 'urgent'
            }
        }
    }

    local {
        env {
            LC_ALL = 'C.UTF-8'
            LANG = 'C.UTF-8'
        }

        process {
            executor = 'local'
            conda    = 'sbdd_cluster_env'
            
            withLabel: process_gpu {
                maxForks = 1
            }
        }
    }
}
