/*
 * conf/slurm.config
 * Slurm HPC cluster configuration
 */

profiles {
    slurm {
        executor {
            name         = 'slurm'
            queueSize    = 50
            pollInterval = '1 sec'
        }

        process {
            executor       = 'slurm'
            queue          = 'main'
            clusterOptions = '--requeue'
            stageInMode    = 'copy'
            scratch        = '$SLURM_TMPDIR'
            conda          = 'sbdd_cluster_env'

            env = [
                LC_ALL: 'C.UTF-8',
                LANG: 'C.UTF-8',
                SCHRODINGER_JOBDB_DIR: './.jobdb'
            ]

            withLabel: process_master {
                executor = 'local'
                scratch  = false
            }

            withLabel: process_gpu {
                queue          = 'main'
                clusterOptions = '--requeue'
                scratch        = '$SLURM_TMPDIR'
            }

            withLabel: process_urgent {
                queue = 'urgent'
            }
        }
    }

    local {
        process {
            executor = 'local'
            conda    = 'sbdd_cluster_env'

            env = [
                LC_ALL: 'C.UTF-8',
                LANG: 'C.UTF-8',
                SCHRODINGER_JOBDB_DIR: './.jobdb'
            ]
            
            withLabel: process_gpu {
                maxForks = 1
            }
        }
    }
}
