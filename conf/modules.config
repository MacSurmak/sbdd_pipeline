/*
 * conf/modules.config
 * Defines output publishing directories for all pipeline stages
 */

process {
    // 0. Healing
    withName: '.*:HEAL_STRUCTURE' {
        publishDir = [
            path: { "${params.outdir}/healed/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 1. Receptor & Ligand Preparation (Clean 3NF Domain Placement)
    withName: '.*:PREPARE_RECEPTOR:SPLIT_PREPARED' {
        publishDir = [
            path: { "${params.outdir}/targets/${meta.target}/frames/${meta.name}" },
            mode: 'copy',
            saveAs: { filename -> filename.endsWith('_receptor.pdb') || filename.endsWith('_receptor.mae') ? filename : null }
        ]
    }

    withName: '.*:PREPARE_LIGANDS:LIGPREP' {
        publishDir = [
            path: { "${params.outdir}/substances/${meta.inchikey}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PARAMETRIZE_POSE' {
        publishDir = [
            path: { "${params.outdir}/substances/${meta.inchikey}/poses/${meta.name}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 2. Docking (Structured per receptor, including first-class execution logs)
    withName: '.*:DOCK_LIBRARY:(MERGE_.*|GENERATE_DOCKING_BOX|CALC_RMSD.*)' {
        publishDir = [
            path: { "${params.outdir}/docking/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:DOCK_LIBRARY:(GNINA_DOCK|GNINA_RESCORE)' {
        publishDir = [
            path: { "${params.outdir}/docking/${meta.frame_id ?: meta.id}/logs" },
            mode: 'copy',
            saveAs: { filename -> filename.endsWith('.log') ? filename : null }
        ]
    }

    withName: '.*:DOCK_LIBRARY:(GNINA_DOCK|GNINA_RESCORE)' {
        publishDir = [
            path: { "${params.outdir}/docking/${meta.frame_id ?: meta.id}/logs" },
            mode: 'copy',
            saveAs: { filename -> filename.endsWith('.log') ? filename : null }
        ]
    }

    withName: '.*:(PRIME_MMGBSA|MERGE_MMGBSA_CHUNKS)' {
        publishDir = [
            path: { meta.ligand_title ? "${params.outdir}/docking/${meta.frame_id ?: meta.id}/${meta.ligand_title}" : "${params.outdir}/docking/${meta.frame_id ?: meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 3. MD Setup (Assembled View & Topology)
    withName: '.*:SETUP_MD_SYSTEM:MERGE_PDB' {
        publishDir = [
            path: { "${params.outdir}/systems/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> "${meta.id}_view.pdb" }
        ]
    }

    // 5. MD Production & Equilibration (Published into canonical md_runs)
    withName: '.*:RUN_MD_CHUNK.*' {
        publishDir = [
            path: { "${params.outdir}/md_runs/${meta.id}/rep_${meta.rep}/raw" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:TRJCAT' {
        // Do not publish raw concatenated trajectory with solvent to save disk space
        publishDir = [
            path: { "${params.outdir}/md_runs/${meta.id}/rep_${meta.rep}/raw" },
            mode: 'copy',
            saveAs: { filename -> null }
        ]
    }

    // 6. MD Analysis, Clustering & MMPBSA
    withName: '.*:GMX_CLUSTER' {
        publishDir = [
            path: { "${params.outdir}/reports/clusters/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:TRJCONV' {
        publishDir = [
            path: { meta.clean_dir ?: "${params.outdir}/md_runs/${meta.rec_id}/rep_${meta.rep}/clean" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MD_METRICS' {
        publishDir = [
            path: { meta.metrics_dir ?: "${params.outdir}/md_runs/${meta.rec_id}/rep_${meta.rep}/metrics" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ANALYZE_MD_TRAJ:.*' {
        publishDir = [
            path: { "${params.outdir}/md_runs/${meta.id}/rep_${meta.rep}/analysis" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:GMX_MMPBSA' {
        publishDir = [
            path: { "${params.outdir}/reports/mmpbsa/${meta.id}_rep_${meta.rep}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 7. Master Reporting
    withName: '.*:SUMMARIZE_.*' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: 'copy'
        ]
    }
}

