/*
 * conf/modules.config
 * Defines output publishing directories for all pipeline stages
 */

process {
    // 1. Receptor & Ligand Preparation
    withName: '.*:PREPARE_RECEPTOR:.*' {
        publishDir = [
            path: { "${params.outdir}/prepared" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PREPARE_LIGANDS:.*' {
        publishDir = [
            path: { "${params.outdir}/ligands" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 2. Docking (Structured per receptor)
    withName: '.*:DOCK_LIBRARY:MERGE_.*' {
        publishDir = [
            path: { "${params.outdir}/docking/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 3. MD Setup
    withName: '.*:SETUP_MD_SYSTEM:.*' {
        publishDir = [
            path: { "${params.outdir}/md/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 5. MD Production & Equilibration
    withName: '.*:RUN_MD_CHUNK.*' {
        publishDir = [
            path: { "${params.outdir}/md/${meta.id}/rep_${meta.rep}/raw" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:TRJCAT' {
        publishDir = [
            path: { "${params.outdir}/md/${meta.id}/rep_${meta.rep}/raw" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 6. MD Analysis, Clustering & MMPBSA
    withName: '.*:GMX_CLUSTER' {
        publishDir = [
            path: { "${params.outdir}/prepared" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:TRJCONV' {
        publishDir = [
            path: { meta.clean_dir ?: "${params.outdir}/md/${meta.rec_id}/rep_${meta.rep}/clean" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MD_METRICS' {
        publishDir = [
            path: { meta.metrics_dir ?: "${params.outdir}/md/${meta.rec_id}/rep_${meta.rep}/metrics" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ANALYZE_MD_TRAJ:.*' {
        publishDir = [
            path: { "${params.outdir}/md/${meta.id}/rep_${meta.rep}/analysis" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:GMX_MMPBSA' {
        publishDir = [
            path: { "${params.outdir}/reports/mmpbsa/${meta.id}_rep_${meta.rep}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 7. Master Reporting
    withName: '.*:SUMMARIZE_.*' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: 'copy'
        ]
    }
}

