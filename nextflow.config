/*
 * Nextflow Master Configuration
 * SBDD Pipeline Nextflow HPC Orchestrator
 */

nextflow.enable.dsl = 2

params {
    // Project parameters
    project_name        = "SBDD_Project"
    outdir              = "${launchDir}"
    workdir             = "/shared/work/${params.project_name}"
    
    // Configs directory
    config_dir          = "${params.outdir}/configs"

    // Primary inputs
    manifest            = null
    dock_plan           = null
    dock_run_name       = null
    clean_plan          = null
    md_plan             = null
    metrics_plan        = null
    cluster_plan        = null
    library             = null
    ref_native          = null
    native_ligand       = ""
    docked_poses        = null
    prime_residue_distance = 15.0
    
    // Orchestration flags (Strictly null, populated by config_loader)
    entry               = null
    mode                = null
    dock_engine         = null
    queue               = "main"
    membrane            = null
    membrane_type       = null
    membrane_topo       = null
    membrane_chains     = null
    upper_lipids        = null
    upper_ratio         = null
    lower_lipids        = null
    lower_ratio         = null
    lipid_padding       = null
    box_padding         = null
    membrane_thickness  = null
    packmol_nloop       = null
    packmol_nloop_all   = null

    // Receptor & Ligand prep (Strictly null, populated by config_loader)
    target_ph           = null
    ph_tolerance        = null
    minimize_rmsd       = null
    cap_termini         = null
    ligand_ph           = null
    ligand_ph_tol       = null
    ligprep_ff          = null
    max_states          = null

    // Docking & Prep resource specifics (Strictly null, populated by config_loader)
    batch_size          = null
    ligprep_cpus        = null
    ligprep_mem_gb      = null
    glide_batch_size    = null
    glide_cpus          = null
    glide_mem_gb        = null
    gnina_batch_size    = null
    gnina_cpus          = null
    gnina_mem_gb        = null
    gnina_gres          = null
    md_cpus             = null
    md_mem_gb           = null
    md_gres             = null
    mmpbsa_cpus         = null
    mmpbsa_mem_gb       = null
    mmgbsa_batch_size   = null
    exhaustiveness      = null
    cnn_scoring         = null
    cnn_model           = null
    num_modes           = null
    autobox_add         = null
    top_k_frames        = null
    percentile_cutoff   = null
    benchmark_ligands   = null
    inner_box           = null
    outer_box           = null
    glide_forcefield    = null
    glide_precision     = null
    glide_recep_vscale  = null
    glide_lig_vscale    = null
    glide_recep_ccut    = null
    glide_lig_ccut      = null
    poses_per_lig       = null
    prime_job_type      = null

    // Ligand parametrization settings (Strictly null, populated by config_loader)
    param_plan            = null
    param_method          = null
    param_ff              = null
    orca_nprocs           = null
    orca_maxcore          = null
    orca_total_mem_mb     = null
    bcc_scfconv           = null
    bcc_grms_tol          = null

    // MD settings (Strictly null, populated by config_loader)
    run_md              = null
    hmr                 = null
    hmr_mass            = null
    water_leaprc        = null
    water_box           = null
    box_type            = null
    ss_cutoff           = null
    water_names         = null
    ion_names           = null
    lipid_names         = null
    declash_cutoff      = null
    declash_niter       = null
    declash_damping     = null
    declash_max_move    = null
    declash_jitter      = null
    declash_tol         = null
    metric_heavy        = null
    metric_hyd          = null
    metric_pol          = null
    md_dt               = null
    md_compressibility  = null
    md_tau_p            = null
    md_total_ns         = null
    md_chunk_ns         = null
    md_replicates       = null
    md_temperature      = null
    md_salt_conc        = null
    md_restraints_fc    = null
    prod_restraints_fc          = null
    prod_restraints_group       = null
    md_hits                     = null
    top_n_hits                  = null
    nvt_short_ps                = null
    nvt_long_ps                 = null
    npt_berendsen_ps            = null
    npt_pr_ps                   = null

    // Analysis (Strictly null, populated by config_loader)
    pbc_center                  = null
    pbc_extract                 = null
    analysis_start_ns           = null
    analysis_sample_interval_ps = null
    per_residue_decomp          = null
    mmpbsa_method               = null
    mmpbsa_gb_model             = null
    mmpbsa_emem                 = null
    mmpbsa_indi                 = null
    mmpbsa_fillratio            = null
    mmpbsa_templates            = "${projectDir}/assets/mmpbsa"

    // Clustering parameters (Strictly null, populated by config_loader)
    cluster_align_group         = null
    cluster_feature_group       = null
    cluster_dim_reduction       = null
    cluster_algorithm           = null
    cluster_rmsd_cutoff         = null
    cluster_tica_lag_ns         = null
    cluster_variance_cutoff     = null
    cluster_n_clusters          = null
    cluster_pocket_radius       = null
    cluster_min_pop             = null
    cluster_temp_k              = null
    cluster_auto_promote        = null

    // Help
    help                = false

    // Global Resource Limits
    max_cpus            = 24
    max_memory          = 30.GB
    max_time            = 240.h
}

// Global workDir isolated on NFS shared scratch
workDir = params.workdir

// Include configuration profiles
includeConfig 'conf/base.config'
includeConfig 'conf/slurm.config'
includeConfig 'conf/modules.config'

// Execution reports
report {
    enabled   = true
    file      = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/reports/execution_timeline.html"
    overwrite = true
}

