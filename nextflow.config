/*
 * Nextflow Master Configuration
 * SBDD Pipeline Nextflow HPC Orchestrator
 */

nextflow.enable.dsl = 2

params {
    // Project parameters
    project_name        = "SBDD_Project"
    outdir              = "${launchDir}"
    workdir             = "/shared/work/${params.project_name}"
    
    // Configs directory
    config_dir          = "${params.outdir}/configs"

    // Primary inputs
    manifest            = null
    dock_plan           = null
    library             = null
    ref_native          = null
    native_ligand       = ""
    docked_poses        = null
    
    // Orchestration flags
    entry               = null
    mode                = "screening"
    dock_engine         = "both"
    queue               = "main"
    membrane            = true
    membrane_type       = "MOM"
    membrane_topo       = "in"
    membrane_chains     = "A"
    upper_lipids        = "POPC:POPE:CHL1"
    upper_ratio         = "5:4:1"
    lower_lipids        = "POPC:POPE:POPS:CHL1"
    lower_ratio         = "4:4:1:1"
    lipid_padding       = 10.0
    box_padding         = 15.0
    membrane_thickness  = 28.0

    // Receptor & Ligand prep
    target_ph           = 7.4
    ph_tolerance        = 1.0
    minimize_rmsd       = 0.3
    cap_termini         = true
    ligand_ph           = 7.4
    ligand_ph_tol       = 2.0
    ligprep_ff          = 16
    max_states          = 32

    // Docking specifics
    batch_size          = 5
    mmgbsa_batch_size   = 5
    exhaustiveness      = 16
    cnn_scoring         = "rescore"
    cnn_model           = "crossdock_default2018"
    num_modes           = 3
    autobox_add         = 4.0
    top_k_frames        = 3
    percentile_cutoff   = 0.50
    benchmark_ligands   = ""
    inner_box           = "10, 10, 10"
    outer_box           = "26, 26, 26"
    glide_forcefield    = "OPLS4"
    glide_precision     = "SP"
    poses_per_lig       = 1
    prime_job_type      = "ENERGY"

    // MD settings (strictly null by default; must come from md.yaml)
    run_md              = null
    water_model         = null
    md_total_ns         = null
    md_chunk_ns         = null
    md_replicates       = null
    md_temperature      = null
    md_salt_conc        = null
    md_hits             = null
    top_n_hits          = null
    nvt_short_ps        = null
    nvt_long_ps         = null
    npt_berendsen_ps    = null
    npt_pr_ps           = null

    // Analysis
    pbc_center          = "Protein"
    pbc_extract         = "COMPLEX"
    mmpbsa_start_ns     = 20.0
    mmpbsa_step_frames  = 40
    per_residue_decomp  = true

    // Help
    help                = false

    // Global Resource Limits
    max_cpus            = 24
    max_memory          = 30.GB
    max_time            = 240.h
}

// Global workDir isolated on NFS shared scratch
workDir = params.workdir

// Include configuration profiles
includeConfig 'conf/base.config'
includeConfig 'conf/slurm.config'
includeConfig 'conf/modules.config'

// Execution reports
report {
    enabled   = true
    file      = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/reports/execution_timeline.html"
    overwrite = true
}

