/*
 * Nextflow Master Configuration
 * SBDD Pipeline Nextflow HPC Orchestrator
 */

nextflow.enable.dsl = 2

params {
    // Project parameters
    project_name        = "SBDD_Project"
    outdir              = "${launchDir}"
    workdir             = "/shared/work/${params.project_name}"
    
    // Configs directory
    config_dir          = "${params.outdir}/configs"

    // Primary inputs
    manifest            = null
    dock_plan           = null
    clean_plan          = null
    md_plan             = null
    metrics_plan        = null
    cluster_plan        = null
    library             = null
    ref_native          = null
    native_ligand       = ""
    docked_poses        = null
    prime_residue_distance = 15.0
    
    // Orchestration flags
    entry               = null
    mode                = "screening"
    dock_engine         = "both"
    queue               = "main"
    membrane            = true
    membrane_type       = "MOM"
    membrane_topo       = "in"
    membrane_chains     = "A"
    upper_lipids        = "POPC:POPE:CHL1"
    upper_ratio         = "5:4:1"
    lower_lipids        = "POPC:POPE:POPS:CHL1"
    lower_ratio         = "4:4:1:1"
    lipid_padding       = 10.0
    box_padding         = 15.0
    membrane_thickness  = 28.0

    // Receptor & Ligand prep (Strictly null, populated by config_loader)
    target_ph           = null
    ph_tolerance        = null
    minimize_rmsd       = null
    cap_termini         = null
    ligand_ph           = null
    ligand_ph_tol       = null
    ligprep_ff          = null
    max_states          = null

    // Docking specifics (Strictly null, populated by config_loader)
    batch_size          = null
    mmgbsa_batch_size   = null
    exhaustiveness      = null
    cnn_scoring         = null
    cnn_model           = null
    num_modes           = null
    autobox_add         = null
    top_k_frames        = null
    percentile_cutoff   = null
    benchmark_ligands   = null
    inner_box           = null
    outer_box           = null
    glide_forcefield    = null
    glide_precision     = null
    glide_recep_vscale  = null
    glide_lig_vscale    = null
    poses_per_lig       = null
    prime_job_type      = null

    // MD settings (Strictly null, populated by config_loader)
    run_md              = null
    water_model         = null
    md_total_ns         = null
    md_chunk_ns         = null
    md_replicates       = null
    md_temperature      = null
    md_salt_conc        = null
    md_restraints_fc    = null
    md_hits             = null
    top_n_hits          = null
    nvt_short_ps        = null
    nvt_long_ps         = null
    npt_berendsen_ps    = null
    npt_pr_ps           = null

    // Analysis (Strictly null, populated by config_loader)
    pbc_center          = null
    pbc_extract         = null
    mmpbsa_start_ns     = null
    mmpbsa_step_frames  = null
    per_residue_decomp  = null

    // Help
    help                = false

    // Global Resource Limits
    max_cpus            = 24
    max_memory          = 30.GB
    max_time            = 240.h
}

// Global workDir isolated on NFS shared scratch
workDir = params.workdir

// Include configuration profiles
includeConfig 'conf/base.config'
includeConfig 'conf/slurm.config'
includeConfig 'conf/modules.config'

// Execution reports
report {
    enabled   = true
    file      = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/reports/execution_timeline.html"
    overwrite = true
}

