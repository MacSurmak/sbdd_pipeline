/*
 * Nextflow Master Configuration
 * SBDD Pipeline Nextflow HPC Orchestrator
 */

nextflow.enable.dsl = 2

params {
    // Project parameters
    project_name        = "SBDD_Project"
    outdir              = "${launchDir}"
    workdir             = "/shared/work/${params.project_name}"
    
    // Configs directory
    config_dir          = "${launchDir}/configs"

    // Primary inputs
    receptor            = null
    native_ligand       = "PKA"
    model_index         = 0
    total_models        = 20
    keep_cofactors      = ""
    library             = null
    ref_native          = null
    docked_poses        = null
    
    // Orchestration flags
    entry               = "all"
    mode                = "screening" // screening, redocking, single
    dock_engine         = "gnina"     // gnina, glide
    membrane            = true
    membrane_type       = "MOM"
    membrane_topo       = "in"
    membrane_chains     = "A"
    upper_lipids        = "POPC:POPE:CHL1"
    upper_ratio         = "1:1:1"
    lower_lipids        = "POPC:POPE:CHL1"
    lower_ratio         = "1:1:1"
    
    // Docking specifics
    batch_size          = 15
    exhaustiveness      = 16
    cnn_scoring         = "rescore"
    num_modes           = 3
    autobox_add         = 4.0
    top_k_frames        = 3
    percentile_cutoff   = 0.50

    // MD settings
    run_md              = true
    md_total_ns         = 60
    md_chunk_ns         = 10
    md_replicates       = 3
    md_temperature      = 310.15
    md_salt_conc        = 0.15
    md_hits             = "native"    // comma-separated hit titles or "top_3"
    top_n_hits          = 1
    
    // Analysis
    mmpbsa_cores        = 16
    mmpbsa_start_ns     = 20.0
    mmpbsa_step_frames  = 40

    // Help
    help                = false
}

// Global workDir isolated on NFS shared scratch
workDir = params.workdir

// Include configuration profiles
includeConfig 'conf/base.config'
includeConfig 'conf/slurm.config'
includeConfig 'conf/modules.config'

// Execution reports
report {
    enabled   = true
    file      = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/reports/execution_timeline.html"
    overwrite = true
}

